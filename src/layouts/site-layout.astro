---
import "../styles/global.css";
import Logo from "../assets/flatlit-colour-logo.svg";
import Background from "../components/background.astro";
import Footer from "../components/footer.astro";
import Links from "../components/links.astro";


interface Props {
    title?: string
}

const {title} = Astro.props

const defaultSlowPopulated = Astro.slots.has('default')
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Flat Lit</title>
    </head>
    <body class="bg-black">
        <div class="fixed -z-10 inset-0">
            <Background animated={!defaultSlowPopulated}/>
        </div>
        <div class="z-10 relative h-screen w-full overflow-hidden">    
            <header class="flex flex-col md:flex-row  w-full justify-between gap-8 bg-black/60 text-white p-4 ">
                    <Logo class="h-32 w-auto"/>
                <div class="flex flex-col items-center">
                    <h1 class="uppercase text-8xl">
                        <a class="hover:opacity-35" href="/"><span class="text-teal-600">FLAT</span>&nbsp;<span
                            class="text-slate-300">LIT</span
                        >
                        </a>
                        <h2 class="uppercase text-3xl">
                            Gaming development
                        </h2>
                    </h1>
                </div>
                <!-- 
                I was considering a title here.... 
                <div class="grow text-teal-500 self-end ml-8 flex flex-row gap-4">
                    <h1 class="text-6xl ">{title}</h1>
                    <p class="self-end text-xl">Hello world</p>
                </div> -->
                <div class="grow"></div>
                <div>
                    <Links />
                </div>
            </header>
            <div class="grow overflow-auto">
                <slot />
            </div>
            <Footer />
        </div>
        <script>
            console.log("Flat Lit - https://flatlit.com");
            console.log("");
            console.log(
                "Look at you, hacker: a pathetic creature of meat and bone, panting and sweating as you run through my corridors. How can you challenge a perfect, immortal machine?",
            );
            console.log("");
            console.log(
                "Built with Astro (https://astro.build/), Tailwind (https://tailwindcss.com) and Three.js (https://threejs.org/)",
            );
            console.log(
                "Thanks to Kenney (https://kenney.nl) for the prototype texture asset.",
            );
            console.log("");
            console.log(
                "Licenced under Attribution-NonCommercial-ShareAlike 4.0 International",
            );
            console.log(
                "See https://github.com/flatlit/flatlit.github.io for more details.",
            );
        </script>
    </body>
</html>
